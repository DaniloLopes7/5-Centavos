# ------------------------------------------------------------------
# Banco de dados
# Local (fora do Docker): SQLite funciona "out of the box" — sem servidor.
# Para usar o PostgreSQL do docker-compose localmente:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5433/five_centavos
# ------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=five_centavos
POSTGRES_PORT=5433
DATABASE_URL=sqlite:///./data/five_centavos.db

# ------------------------------------------------------------------
# Segurança / Autenticação JWT
# ------------------------------------------------------------------
SECRET_KEY=troque-esta-chave-por-uma-chave-segura-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
DASHBOARD_PORT=8501
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Execução do ETL no startup (true/false)
RUN_ETL=false

# URL interna da API usada pelo Dashboard (dentro do docker-compose: http://api:8000)
API_URL=http://localhost:8000
