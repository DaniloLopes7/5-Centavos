# ------------------------------------------------------------------
# Banco de dados
# Local: SQLite, sem servidor de banco.
# PostgreSQL: postgresql+psycopg2://usuario:senha@host:5432/five_centavos
# Acrescente ?sslmode=require quando o provedor exigir TLS.
# ------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=five_centavos
POSTGRES_PORT=5433
DATABASE_URL=sqlite:///./data/five_centavos.db

# ------------------------------------------------------------------
# Segurança / autenticação JWT
# Use este valor somente em desenvolvimento. O Render gera um segredo próprio.
# ------------------------------------------------------------------
SECRET_KEY=chave-insegura-de-desenvolvimento
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
DASHBOARD_PORT=8501
CORS_ORIGINS=https://5-centavos.vercel.app,http://localhost:8501,http://localhost:3000,http://localhost:8080
RUN_ETL=false
PYTHONPATH=src
PYTHON_VERSION=3.12.14

# URL da API consumida pelo dashboard (no Docker Compose, usa o serviço `api`).
API_URL=http://localhost:8000

# URLs públicas usadas pela landing. Copie os valores de produção para
# landing/config.js antes do deploy; a Vercel serve arquivos estáticos e não
# injeta variáveis de ambiente do servidor no JavaScript do navegador.
PUBLIC_API_URL=https://PREENCHER-COM-A-URL-DA-API
PUBLIC_DASHBOARD_URL=https://PREENCHER-COM-A-URL-DO-DASHBOARD
LANDING_URL=http://localhost:8080
